{
	"name": "selfcheckin",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-21",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "APARTMENT_KNOWLEDGE",
			"index_name": "apartment-knowledge",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "PROMPTS",
			"id": "2378b10eb26e44389c54217c4fe4e8dc",
			"remote": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "selfcheckin-db",
			"database_id": "f2c370a6-4019-4c94-8b8e-40c03f015ed5",
			"remote": true
		}
	]
}