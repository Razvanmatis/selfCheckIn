{
	"name": "selfcheckin",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-21",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "APARTMENT_KNOWLEDGE",
			"index_name": "apartment-knowledge",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "PROMPTS",
			"id": "2378b10eb26e44389c54217c4fe4e8dc"
		}
	]
}